        "variables": {},
        "svgcontent": "<svg width=\"1280\" height=\"760\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:svg=\"http://www.w3.org/2000/svg\" xmlns:html=\"http://www.w3.org/1999/xhtml\"><g><title>Layer 1</title><rect x=\"0\" y=\"0\" width=\"1280\" height=\"760\" fill=\"#f7f9fb\"/><text x=\"40\" y=\"46\" font-family=\"sans-serif\" font-size=\"24\" fill=\"#12181f\" font-weight=\"bold\">Conveyor box sorter \u2014 HMI</text><text x=\"40\" y=\"72\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#333333\">OpenPLC Runtime v4 over Modbus TCP \u00b7 sort by size \u00b7 straight = SMALL, pusher 1 = LARGE, pusher 2 = REJECT</text><rect x=\"40\" y=\"100\" width=\"520\" height=\"180\" rx=\"8\" fill=\"#ffffff\" stroke=\"#cfd8e3\"/><text x=\"60\" y=\"130\" font-family=\"sans-serif\" font-size=\"15\" fill=\"#0b3d91\" font-weight=\"bold\">Line</text><g id=\"GSE_00000000-0000-4000-8000-000000000001\" type=\"svg-ext-gauge_semaphore\" fill=\"#000000\" font-size=\"14\" stroke=\"#000000\" font-family=\"sans-serif\" text-anchor=\"middle\"><ellipse cx=\"130\" cy=\"195\" rx=\"22\" ry=\"22\" fill=\"#bdbdbd\" stroke=\"#000000\"/></g><text x=\"130\" y=\"252\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#333333\" text-anchor=\"middle\">conveyor motor</text><g id=\"GSE_00000000-0000-4000-8000-000000000002\" type=\"svg-ext-gauge_semaphore\" fill=\"#000000\" font-size=\"14\" stroke=\"#000000\" font-family=\"sans-serif\" text-anchor=\"middle\"><ellipse cx=\"290\" cy=\"195\" rx=\"22\" ry=\"22\" fill=\"#bdbdbd\" stroke=\"#000000\"/></g><text x=\"290\" y=\"252\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#333333\" text-anchor=\"middle\">RUN</text><g id=\"GSE_00000000-0000-4000-8000-000000000003\" type=\"svg-ext-gauge_semaphore\" fill=\"#000000\" font-size=\"14\" stroke=\"#000000\" font-family=\"sans-serif\" text-anchor=\"middle\"><ellipse cx=\"380\" cy=\"195\" rx=\"22\" ry=\"22\" fill=\"#bdbdbd\" stroke=\"#000000\"/></g><text x=\"380\" y=\"252\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#333333\" text-anchor=\"middle\">FAULT</text><g id=\"GSE_00000000-0000-4000-8000-000000000004\" type=\"svg-ext-gauge_semaphore\" fill=\"#000000\" font-size=\"14\" stroke=\"#000000\" font-family=\"sans-serif\" text-anchor=\"middle\"><ellipse cx=\"470\" cy=\"195\" rx=\"22\" ry=\"22\" fill=\"#bdbdbd\" stroke=\"#000000\"/></g><text x=\"470\" y=\"252\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#333333\" text-anchor=\"middle\">REJECT</text><rect x=\"600\" y=\"100\" width=\"300\" height=\"180\" rx=\"8\" fill=\"#ffffff\" stroke=\"#cfd8e3\"/><text x=\"620\" y=\"130\" font-family=\"sans-serif\" font-size=\"15\" fill=\"#0b3d91\" font-weight=\"bold\">Status</text><text x=\"620\" y=\"166\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#333333\">state</text><text x=\"620\" y=\"216\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#333333\">fault</text><rect x=\"40\" y=\"300\" width=\"520\" height=\"150\" rx=\"8\" fill=\"#ffffff\" stroke=\"#cfd8e3\"/><text x=\"60\" y=\"330\" font-family=\"sans-serif\" font-size=\"15\" fill=\"#0b3d91\" font-weight=\"bold\">Counters</text><g id=\"VAL_00000000-0000-4000-8000-000000000030\" type=\"svg-ext-value\" fill=\"#000000\" stroke-width=\"0\" font-family=\"sans-serif\" text-anchor=\"middle\" font-size=\"28\"><text x=\"110\" y=\"402\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"34\" fill=\"#12181f\">0</text></g><text x=\"110\" y=\"432\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#333333\" text-anchor=\"middle\">SMALL (lane A)</text><g id=\"VAL_00000000-0000-4000-8000-000000000031\" type=\"svg-ext-value\" fill=\"#000000\" stroke-width=\"0\" font-family=\"sans-serif\" text-anchor=\"middle\" font-size=\"28\"><text x=\"290\" y=\"402\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"34\" fill=\"#12181f\">0</text></g><text x=\"290\" y=\"432\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#333333\" text-anchor=\"middle\">LARGE (lane B)</text><g id=\"VAL_00000000-0000-4000-8000-000000000032\" type=\"svg-ext-value\" fill=\"#000000\" stroke-width=\"0\" font-family=\"sans-serif\" text-anchor=\"middle\" font-size=\"28\"><text x=\"460\" y=\"402\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"34\" fill=\"#12181f\">0</text></g><text x=\"460\" y=\"432\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#333333\" text-anchor=\"middle\">REJECT (lane C)</text><rect x=\"40\" y=\"480\" width=\"520\" height=\"170\" rx=\"8\" fill=\"#ffffff\" stroke=\"#cfd8e3\"/><text x=\"60\" y=\"510\" font-family=\"sans-serif\" font-size=\"15\" fill=\"#0b3d91\" font-weight=\"bold\">Control (web HMI)</text><text x=\"600\" y=\"332\" font-family=\"sans-serif\" font-size=\"15\" fill=\"#0b3d91\" font-weight=\"bold\">What the HMI may and may not do</text><text x=\"600\" y=\"364\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#333333\">Start and Stop are allowed from this screen (momentary, held for the click).</text><text x=\"600\" y=\"388\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#333333\">There is no Reset control here, by design (SR-08): a safety latch is only</text><text x=\"600\" y=\"412\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#333333\">cleared by the physical Reset button on the panel, then a separate Start.</text><text x=\"600\" y=\"436\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#333333\">The E-Stop is hardwired in the motor contactor circuit \u2014 the HMI cannot</text><text x=\"600\" y=\"460\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#333333\">defeat it, and losing this screen never stops or restarts the line (TC-29).</text><g id=\"HXB_00000000-0000-4000-8000-000000000010\" type=\"svg-ext-html_button\" fill=\"#FFFFFF\" font-size=\"16\" font-family=\"sans-serif\" text-anchor=\"middle\" stroke=\"#000000\"><rect x=\"90\" y=\"545\" width=\"150\" height=\"56\" rx=\"6\" fill=\"#2e9e44\" stroke=\"none\"/><foreignObject id=\"H-HXB_00000000-0000-4000-8000-000000000010\" x=\"90\" y=\"545\" width=\"150\" height=\"56\"><BUTTON id=\"B-HXB_00000000-0000-4000-8000-000000000010\" style=\"width:100%;height:100%;background-color:#2e9e44;color:#ffffff;\" class=\"md-btn md-btn-raised\">START</BUTTON></foreignObject></g><g id=\"HXB_00000000-0000-4000-8000-000000000011\" type=\"svg-ext-html_button\" fill=\"#FFFFFF\" font-size=\"16\" font-family=\"sans-serif\" text-anchor=\"middle\" stroke=\"#000000\"><rect x=\"270\" y=\"545\" width=\"150\" height=\"56\" rx=\"6\" fill=\"#c62828\" stroke=\"none\"/><foreignObject id=\"H-HXB_00000000-0000-4000-8000-000000000011\" x=\"270\" y=\"545\" width=\"150\" height=\"56\"><BUTTON id=\"B-HXB_00000000-0000-4000-8000-000000000011\" style=\"width:100%;height:100%;background-color:#c62828;color:#ffffff;\" class=\"md-btn md-btn-raised\">STOP</BUTTON></foreignObject></g><g id=\"HXS_00000000-0000-4000-8000-000000000020\" type=\"svg-ext-html_select\" text-anchor=\"left\" font-family=\"sans-serif\" font-size=\"16\" fill=\"#000000\"><rect x=\"660\" y=\"142\" width=\"220\" height=\"32\" fill=\"#eef2f7\" stroke=\"#cfd8e3\"/><foreignObject id=\"H-HXS_00000000-0000-4000-8000-000000000020\" x=\"660\" y=\"142\" width=\"220\" height=\"32\"><SELECT id=\"S-HXS_00000000-0000-4000-8000-000000000020\" style=\"width:100%;height:100%;text-align:left;\"></SELECT></foreignObject></g><g id=\"HXS_00000000-0000-4000-8000-000000000021\" type=\"svg-ext-html_select\" text-anchor=\"left\" font-family=\"sans-serif\" font-size=\"16\" fill=\"#000000\"><rect x=\"660\" y=\"192\" width=\"220\" height=\"32\" fill=\"#eef2f7\" stroke=\"#cfd8e3\"/><foreignObject id=\"H-HXS_00000000-0000-4000-8000-000000000021\" x=\"660\" y=\"192\" width=\"220\" height=\"32\"><SELECT id=\"S-HXS_00000000-0000-4000-8000-000000000021\" style=\"width:100%;height:100%;text-align:left;\"></SELECT></foreignObject></g></g></svg>"
      }
    ]
  },
